# 단일 소유자용 원격 서버. 이 파일을 .env로 복사한 뒤 값을 설정하세요.
MYBOX_TOKEN=
# HTTPS 프록시의 외부 도메인. 끝에 /mcp를 붙이지 마세요.
MCP_PUBLIC_URL=https://mybox.example.com
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 위 명령으로 만든 32자 이상의 암호를 설정합니다. MYBOX PAT와 다른 값입니다.
MCP_OWNER_SECRET=
HOST=127.0.0.1
PORT=3001
# 원격 앱의 서버 로컬 파일 접근은 기본 비활성화입니다.
# 전용 전송 폴더를 지정한 경우에만 그 폴더 내 업로드/다운로드를 제공합니다.
# MYBOX_TRANSFER_DIR=/absolute/path/to/mybox-transfers
