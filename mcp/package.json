{
  "name": "mybox-ai-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "NAVER MYBOX file management MCP with native agent vision for scanned PDFs and images.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "start:http": "node dist/http.mjs",
    "test": "npm run build && node --test test/core.test.mjs test/http.test.mjs test/setup.test.mjs test/network.test.mjs test/management.test.mjs test/site.test.mjs",
    "setup": "node ../scripts/setup-mybox.mjs",
    "setup:cli": "node ../scripts/setup-mybox.mjs --cli"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.10",
    "cfb": "1.2.2",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "unpdf": "1.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
